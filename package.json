{
  "name": "dc-bot",
  "version": "1.0.0",
  "description": "A feature-rich open-source Discord bot for competitive programming communities (Codeforces, AtCoder, Toph, GitHub)",
  "main": "index.js",
  "scripts": {
    "start": "node deploy-commands.js && node index.js",
    "deploy": "node deploy-commands.js",
    "dev": "node --watch index.js",
    "set-avatar": "node scripts/set-bot-avatar.js"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "discord",
    "bot",
    "competitive-programming",
    "codeforces",
    "atcoder",
    "toph",
    "github",
    "discordjs"
  ],
  "author": "Pri8899",
  "repository": {
    "type": "git",
    "url": "https://github.com/Pri8899/DC-Bot.git"
  },
  "bugs": {
    "url": "https://github.com/Pri8899/DC-Bot/issues"
  },
  "homepage": "https://github.com/Pri8899/DC-Bot#readme",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "axios": "^1.16.1",
    "better-sqlite3": "^12.10.0",
    "discord.js": "^14.26.4",
    "dotenv": "^17.4.2",
    "node-cron": "^4.2.1"
  }
}
