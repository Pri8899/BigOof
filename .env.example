# ============================================================
#  CP Discord Bot — Environment Configuration
#  Copy this file to .env and fill in your values
# ============================================================

# Discord Bot Token (from https://discord.com/developers/applications)
DISCORD_TOKEN=your_bot_token_here

# Your Discord Server (Guild) ID
GUILD_ID=your_guild_id_here

# Channel IDs (create these channels in your server first)
CONTEST_CHANNEL_ID=your_contest_channel_id_here
DASHBOARD_CHANNEL_ID=your_dashboard_channel_id_here

# Your Bot's Application/Client ID
CLIENT_ID=your_client_id_here
GENERAL_CHANNEL_ID=your_general_channel_id_here
