# ============================================================
#  BigOof — The Autonomous Competitive Programming Discord Bot
#  Copy this file to .env and fill in your values
# ============================================================

# ── Core Discord Credentials (Required) ─────────────────────
# Obtain from https://discord.com/developers/applications
DISCORD_TOKEN=your_bot_token_here
CLIENT_ID=your_client_id_here

# Bot Owner User ID (Required to access sensitive admin commands like /backupdb and /restoredb)
OWNER_ID=your_discord_user_id_here

# ── Optional: Guild Deployment ──────────────────────────────
# Leave blank to deploy slash commands globally across all servers.
# Provide a Guild ID if you want instant slash command deployment to a single development server.
GUILD_ID=

# ── Optional: GitHub API Integration ────────────────────────
# Personal Access Token (classic or fine-grained) to increase GitHub API rate limits from 60 to 5,000 req/hr
GITHUB_TOKEN=

# ── Optional: Localization & Timezone ───────────────────────
# Standard IANA Timezone (e.g. UTC, America/New_York, Asia/Dhaka, Europe/London)
# Defaults to UTC if unset
TIMEZONE=UTC

# ── Optional: Default Global Channel Fallbacks ──────────────
# In multi-server mode, channels can be configured per server using /set-channel.
# You can optionally set fallback channel IDs here for single-server setups:
FEED_CHANNEL_ID=
DASHBOARD_CHANNEL_ID=
CONTEST_CHANNEL_ID=
RATING_CHANNEL_ID=
SUGGEST_CHANNEL_ID=
GITHUB_CHANNEL_ID=
BACKUP_CHANNEL_ID=
GENERAL_CHANNEL_ID=

# ── Optional: Database Path ─────────────────────────────────
# Custom path for the SQLite database file (defaults to ./bigoof.db)
DATABASE_PATH=
