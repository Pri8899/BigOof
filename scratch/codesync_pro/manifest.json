{
  "manifest_version": 3,
  "name": "CodeSync Pro",
  "version": "1.0.0",
  "description": "Automatically syncs your accepted Codeforces, AtCoder, and LeetCode submissions to a GitHub repository.",
  "permissions": [
    "storage",
    "alarms",
    "notifications",
    "scripting",
    "tabs",
    "offscreen"
  ],
  "host_permissions": [
    "https://codeforces.com/*",
    "https://mirror.codeforces.com/*",
    "https://api.github.com/*",
    "https://atcoder.jp/*",
    "https://leetcode.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://codeforces.com/*",
        "https://mirror.codeforces.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://atcoder.jp/*"
      ],
      "js": [
        "content_ac.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://leetcode.com/*"
      ],
      "js": [
        "content_lc.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "CodeSync Pro"
  },
  "options_page": "options.html",
  "web_accessible_resources": [
    {
      "resources": ["noti.mp3"],
      "matches": ["<all_urls>"]
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}